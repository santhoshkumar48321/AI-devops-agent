# OpenAI API key (required for LLM-powered reasoning)
OPENAI_API_KEY=sk-your-openai-api-key-here

# OpenAI model to use (gpt-4o recommended for best results)
OPENAI_MODEL=gpt-4o

# FastAPI server settings
API_HOST=0.0.0.0
API_PORT=8000

# Memory / vector store settings
MEMORY_DIR=./data/memory
MAX_MEMORY_RESULTS=5

# Kubernetes settings (leave blank to use current kubeconfig context)
KUBECONFIG=

# Ansible settings
ANSIBLE_PRIVATE_DATA_DIR=./data/ansible

# Audit log path
AUDIT_LOG_PATH=./data/audit.log

# Documentation output directory
DOCS_OUTPUT_DIR=./docs/incidents

# Safety: require confirmation before destructive actions (true/false)
REQUIRE_CONFIRMATION=true

# RBAC: comma-separated list of allowed roles (admin, operator, viewer)
ALLOWED_ROLES=admin,operator
